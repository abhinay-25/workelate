# BuildSprint R3 — Environment Configuration Template
# Copy to `.env` in the repository root and fill in real API keys if enabling LLM fallback.
# The backend starts cleanly in deterministic-first mode even without LLM keys configured.

# --- 3-Tier LLM Fallback Chain (Primary: Groq -> Secondary: Gemini -> Fallback: OpenAI) ---
GROQ_API_KEY=your_groq_api_key_here
R3_GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your_gemini_api_key_here
R3_GEMINI_MODEL=gemini-2.5-flash-lite

OPENAI_API_KEY=your_openai_api_key_here
R3_OPENAI_MODEL=gpt-4o-mini

# --- Optional Embedding / Vector Store Overrides ---
# Defaults to local deterministic 256d concept+hashed dense vectors in SQLite `record_vectors`.
R3_EMBEDDING_PROVIDER=local
R3_VECTOR_BACKEND=sqlite

# --- Optional Database & Frontend CORS Overrides ---
# R3_DB_PATH=.r3_assist.db
# R3_FRONTEND_ORIGIN=http://localhost:5173
